#:import AppColors kartupedia.core.theme.AppColors
#:import AppTypography kartupedia.core.theme.AppTypography
#:import AppRadius kartupedia.core.theme.AppRadius


<SectionHeader>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(32)

    Label:
        text: root.title
        color: AppColors.TEXT
        font_size: AppTypography.SECTION
        bold: True
        halign: "left"
        valign: "middle"
        text_size: self.size
        size_hint_x: 1

    _ActionLabel:
        text: root.action_text
        color: AppColors.PRIMARY_LIGHT
        font_size: AppTypography.CAPTION
        bold: True
        halign: "right"
        valign: "middle"
        text_size: self.size
        size_hint_x: None
        # Tombol aksi hanya tampil & aktif kalau action_text DAN on_action ada,
        # sama seperti perilaku asli (dulu widget-nya cuma dibuat kalau kondisi ini terpenuhi).
        width: dp(90) if (root.action_text and root.on_action) else 0
        opacity: 1 if (root.action_text and root.on_action) else 0
        disabled: not (root.action_text and root.on_action)
        on_release: root._fire_action()


<MetadataItem>:
    orientation: "vertical"
    spacing: dp(2)

    Label:
        text: root.value
        color: AppColors.TEXT
        font_size: AppTypography.BODY
        bold: True

    Label:
        text: root.label
        color: AppColors.TEXT_MUTED
        font_size: AppTypography.META


<DifficultyBadge>:
    size_hint: None, None
    size: dp(70), dp(24)
    canvas.before:
        Color:
            rgba: root.badge_bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [AppRadius.PILL]

    Label:
        text: root.difficulty
        color: root.badge_color
        font_size: AppTypography.META
        bold: True
