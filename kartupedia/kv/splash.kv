#:import AppColors kartupedia.core.theme.AppColors
#:import AppTypography kartupedia.core.theme.AppTypography
#:import APP_NAME kartupedia.config.APP_NAME
#:import APP_TAGLINE kartupedia.config.APP_TAGLINE
#:import VectorIcon kartupedia.widgets.icons.VectorIcon


<SplashScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: AppColors.BG
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [0]

        # Logo splash: background PRIMARY berbentuk rounded square + VectorIcon("cards"),
        # sama seperti logo di Home. Mulai transparan (opacity: 0), di-fade-in oleh
        # SplashScreen.on_kv_post() di splash.py.
        FloatLayout:
            id: logo_wrap
            size_hint: None, None
            size: dp(100), dp(100)
            pos_hint: {"center_x": 0.5, "center_y": 0.57}
            opacity: 0
            canvas.before:
                Color:
                    rgba: AppColors.PRIMARY
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(22)]

            VectorIcon:
                name: "cards"
                color: AppColors.WHITE
                size_hint: 0.72, 0.72
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Label:
            id: title_label
            text: APP_NAME
            color: AppColors.TEXT
            font_size: AppTypography.HERO
            bold: True
            size_hint: None, None
            size: dp(320), dp(46)
            pos_hint: {"center_x": 0.5, "center_y": 0.46}
            halign: "center"
            valign: "middle"
            text_size: self.size
            opacity: 0

        Label:
            id: subtitle_label
            text: APP_TAGLINE
            color: AppColors.TEXT_SECONDARY
            font_size: AppTypography.CAPTION
            size_hint: None, None
            size: dp(300), dp(38)
            pos_hint: {"center_x": 0.5, "center_y": 0.415}
            halign: "center"
            valign: "top"
            text_size: self.size
            opacity: 0
